# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
CORS_ORIGIN=*

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
GOOGLE_WEB_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com

# Password Reset Configuration
RESET_PASSWORD_EXPIRES_MINUTES=60
CLIENT_RESET_URL=http://localhost:3000/reset-password

# Email Service (Nodemailer SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="DietCompass Support <noreply@dietcompass.com>"

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Spoonacular API
SPOONACULAR_API_KEY=your_spoonacular_api_key_here
