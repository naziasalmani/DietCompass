  "description": "Backend server and API for DietCompass application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test-auth.js && node test-profile-personalization.js && node test-ai.js && node test-recipes.js",
    "test:auth": "node test-auth.js",
    "test:profile": "node test-profile-personalization.js",
    "test:ai": "node test-ai.js",
    "test:recipes": "node test-recipes.js"
