    "google-auth-library": "^9.14.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0"
